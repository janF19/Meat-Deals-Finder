# API Keys
AGENTQL_API_KEY=your_agentql_key
OPENAI_API_KEY=your_openai_key
SGAI_API_KEY=your_sgai_key
SPOONACULAR_API_KEY=your_spoonacular_key

# Database Configuration
DB_NAME=rohlikdb
DB_USER=rohlik
DB_PASSWORD=your_db_password
DB_HOST=your_db_host.region.rds.amazonaws.com
DB_PORT=5432

# Deployment URLs
FRONTEND_URL=http://your_ec2_ip
BACKEND_URL=http://your_ec2_ip:8000
ALLOWED_ORIGINS=http://your_ec2_ip
REACT_APP_API_URL=http://your_ec2_ip:8000

# AWS Deployment (needed for GitHub Actions)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
EC2_HOST=your_ec2_ip
EC2_SSH_KEY=your_private_ssh_key